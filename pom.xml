<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>localmods</groupId>
    <artifactId>PandorasStart</artifactId>
    <version>0.1.0</version>
    <name>Pandora's Start</name>
    <description>Adds a Neow option that replaces your starter relic with Pandora's Box.</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Defaults are set for this machine's Steam installation. Override with -D... if needed. -->
        <steam.apps>D:/STEAM/steamapps</steam.apps>
        <sts.jar>${steam.apps}/common/SlayTheSpire/desktop-1.0.jar</sts.jar>
        <mts.jar>${steam.apps}/workshop/content/646570/1605060445/ModTheSpire.jar</mts.jar>
        <basemod.jar>${steam.apps}/workshop/content/646570/1605833019/BaseMod.jar</basemod.jar>
        <sts.mods.dir>${steam.apps}/common/SlayTheSpire/mods</sts.mods.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.megacrit.cardcrawl</groupId>
            <artifactId>slaythespire</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${sts.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>com.evacipated.cardcrawl</groupId>
            <artifactId>modthespire</artifactId>
            <version>3.0</version>
            <scope>system</scope>
            <systemPath>${mts.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>basemod</groupId>
            <artifactId>basemod</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${basemod.jar}</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-to-sts-mods</id>
                        <phase>package</phase>
                        <configuration>
                            <target>
                                <mkdir dir="${sts.mods.dir}"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="${sts.mods.dir}"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
